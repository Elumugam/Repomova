# ==============================================================================
# Repomova — Environment Variables Example
# ==============================================================================
# Copy this file to `.env` in the project root and provide your actual credentials.
#
# IMPORTANT:
# - Never commit your `.env` file to source control.
# - The application will run in local demo mode if Supabase keys are not set.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Cloud Persistence & Auth)
# Required for cloud synchronization and multi-device persistence.
# If omitted, Repomova operates in offline/local demo mode.
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous / Publishable Key (safe for browser client-side use)
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Optional: Server-side environment variable aliases for Vercel/Node functions
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key-here

# Optional: Supabase Service Role Secret Key (Backend API admin operations only)
# WARNING: Keep this strictly confidential; never prefix with VITE_ or expose to client
# SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# GitHub Integration (Optional)
# Used for backend GitHub OAuth repository authorization and private repo imports.
# ------------------------------------------------------------------------------
# GITHUB_CLIENT_ID=your-github-oauth-client-id
# GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# ------------------------------------------------------------------------------
# Runtime Infrastructure (Optional)
# Configures external microservices for isolated code execution and iframe proxies.
# If unset, Repomova uses its built-in client-side and serverless adapters.
# ------------------------------------------------------------------------------
# RUNTIME_BASE_URL=http://localhost:8080
# PREVIEW_GATEWAY_URL=http://localhost:3001
